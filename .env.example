# Configuración de Base de Datos PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=soc_password
POSTGRES_DB=soc_lite_db

# Seguridad y Autenticación JWT
SECRET_KEY=soc-lite-super-secret-key-32-chars-long-security-token-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Microservicio LangChain & LLM
LANGCHAIN_SERVICE_URL=http://langchain-service:8001
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3:8b

# Threat Intelligence (Opcional - Llaves de API reales)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
